{
  "id": "options-bug",
  "name": "Test game options-bug",
  "version": "0.1.0",
  "sdk": "^0.1.3",
  "license": { "code": "MIT", "assets": "CC0-1.0" },
  "mode": "turn-based",
  "players": { "min": 2, "max": 3 },
  "server": true,
  "client": "client",
  "roles": { "player": { "inputs": ["touch"], "screen": "small" } },
  "options": {
    "ziel": {
      "label": "Ziel",
      "type": "choice",
      "default": 10,
      "choices": [
        { "value": 10, "label": "10" },
        { "value": 20, "label": "20" },
        { "value": 30, "label": "30" }
      ]
    },
    "gross": { "label": "Große Schritte", "type": "boolean", "default": false }
  }
}
