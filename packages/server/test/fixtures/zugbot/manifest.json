{
  "id": "zugbot",
  "name": "Zugbot",
  "version": "1.0.0",
  "sdk": "^0.1.8",
  "license": { "code": "MIT", "assets": "CC0-1.0" },
  "mode": "turn-based",
  "players": { "min": 2, "max": 4 },
  "server": true,
  "client": "client",
  "roles": { "player": { "inputs": ["touch"], "screen": "small" } },
  "options": {
    "bot": {
      "label": "Bot",
      "type": "choice",
      "default": "gut",
      "choices": [
        { "value": "gut", "label": "gut" },
        { "value": "kaputt", "label": "kaputt" },
        { "value": "falsch", "label": "falsch" },
        { "value": "absturz", "label": "absturz" }
      ]
    }
  }
}
