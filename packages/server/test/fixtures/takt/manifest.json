{
  "id": "takt",
  "name": "Takt",
  "version": "1.0.0",
  "sdk": "^0.1.3",
  "license": { "code": "MIT", "assets": "CC0-1.0" },
  "mode": "realtime",
  "players": { "min": 1, "max": 2 },
  "server": true,
  "client": "client",
  "roles": { "controller": { "inputs": ["touch"], "screen": "small" } },
  "options": {
    "schritt": {
      "label": "Schritt",
      "type": "choice",
      "default": 1,
      "choices": [
        { "value": 1, "label": "eins" },
        { "value": 5, "label": "fünf" }
      ]
    },
    "tasten": { "label": "Tasten", "type": "boolean", "default": true }
  }
}
