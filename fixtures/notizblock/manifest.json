{
  "id": "notizblock",
  "name": "Notizblock",
  "version": "0.1.0",
  "description": "Realtime test game: everyone types notes and spills ink, a TV may show the pad",
  "sdk": "^0.1.7",
  "license": { "code": "MIT", "assets": "CC0-1.0" },
  "mode": "realtime",
  "players": { "min": 1, "max": 4 },
  "server": true,
  "client": "dist/client",
  "roles": {
    "player": { "inputs": ["touch", "keyboard"], "screen": "small" },
    "screen": { "inputs": [], "screen": "large", "optional": true }
  }
}
